---
import Button from "./Button.astro";

const { title = "" } = Astro.props;
---

<div class={`
  bg-secondary
  p-md pt-xl rounded-3xl rounded-bl-none
  flex flex-col gap-md
  min-h-100
`}>
  <h3>{title}</h3>
  <p class="flex-auto"><slot /></p>

  <Button variant="ghost" class="self-end">lees meer →</Button>
</div>
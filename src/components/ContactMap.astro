---
// Comps
import { Image } from "astro:assets";
import Button from "./Button.astro";

// Content (sourced from src/data/site.ts)
import { contact } from '../data/site'
---

<section class={`
  bg-white
`}>
  <article class="container py-5xl flex flex-col lg:flex-row gap-xl">
    <div class="flex-auto flex flex-col">
      <header class="flex flex-col gap-sm">
        <h2>{contact.title}</h2>
        <p class="max-w-120">{contact.description}</p>
      </header>
  
      <ul class="py-2xl flex flex-col gap-md">
        {contact.contactData.map(item => (
          <li class="flex gap-md">
            <div class="bg-secondary-200 p-md rounded-xl rounded-tr-none">
              <Image src={item.icon} alt={item.title} />
            </div>
            <div class="flex flex-col">
              <h4>{item.title}</h4>
              {item.description.map(desc => <p>{desc}</p>)}
              {item.link && (
                <Button
                  variant="ghost"
                  href={item.link.href}
                  arrow
                >
                  {item.link.text}
                </Button>
              )}
            </div>
          </li>
        ))}
      </ul>

      {contact.cta && (
        <div class="flex-none">
          <Button href={contact.cta.href}>
            {contact.cta.text}
            <Image class="-scale-x-100" src={contact.cta.icon} alt="Contact icon" />
          </Button>
        </div>
      )}
    </div>

    <div class="rounded-3xl rounded-bl-none overflow-hidden">
      <Image src={contact.map} alt="Map utrecht" class="w-full" />
    </div>
  </article>
</section>
---
const {
	bg = 'bg-white',
	title = '',
	description = '',
	horizontal = false
} = Astro.props;
---

<section class={`py-5xl ${bg}`}>
	<article class={`
		container flex
		${horizontal ? 'flex-row' : 'flex-col'}
		gap-2xl
	`}>
		<header class="flex flex-col items-center gap-sm">
			{title && <h2 class="text-center">{title}</h2>}
			{description && <p class="text-center max-w-180">{description}</p>}
		</header>

		<slot />

	</article>
</section>

<style>

</style>
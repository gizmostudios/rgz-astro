      d="M8.46875 31.6403C8.46875 29.3018 10.3645 27.406 12.7031 27.406H16.9374V31.6403C16.9374 33.9789 15.0416 35.8747 12.7031 35.8747V35.8747C10.3645 35.8747 8.46875 33.9789 8.46875 31.6403V31.6403Z"

---
import Arrow from "./Arrow.astro";

type Size = "xs" | "sm" | "md" | "lg";
type Variant = "primary" | "secondary" | "ghost";

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  arrow = false
} = Astro.props as {
  href?: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  type?: "button" | "submit" | "reset";
  arrow?: boolean
};

const base = `
  ${arrow ? 'justify-between' : 'justify-center'}
  inline-flex items-center gap-md
  rounded-lg font-medium
  transition focus:outline-none focus:ring-2 focus:ring-accent/40
  cursor-pointer
  group
`;
const sizes = {
  xs: "h-9 text-sm",
  sm: "h-9 px-4 text-sm",
  md: "h-10 px-4 text-sm",
  lg: "h-11 px-4 text-md",
  xl: "h-12 px-4 text-lg",
};
const variants = {
  primary: "bg-primary text-white hover:shadow-md hover:bg-primary-600",
  secondary: "bg-white text-primary hover:shadow-md hover:bg-primary-600 hover:text-white",
  ghost: "border-l-2 rounded-l-none border-primary bg-transparent text-primary hover:bg-secondary-100",
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={cls}>
  <slot />
  {arrow && <Arrow class="-translate-x-1 group-hover:translate-x-1" />}
</Tag>
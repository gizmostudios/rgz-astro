---
type Size = "xs" | "sm" | "md" | "lg";
type Variant = "primary" | "secondary" | "ghost";

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
  arrow = false
} = Astro.props as {
  href?: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  type?: "button" | "submit" | "reset";
  arrow?: boolean
};

const base = `
  inline-flex items-center justify-center gap-md
  rounded-lg font-medium
  transition focus:outline-none focus:ring-2 focus:ring-accent/40
  cursor-pointer
`;
const sizes = {
  xs: "h-9 text-sm",
  sm: "h-9 px-3 text-sm",
  md: "h-10 px-4 text-sm",
  lg: "h-11 px-5 text-base",
};
const variants = {
  primary: "bg-primary text-white hover:brightness-95",
  secondary: "bg-white text-primary hover:brightness-95",
  ghost: "bg-transparent text-primary hover:bg-surface",
};
const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={cls}>
  <slot />
  {arrow && <span>→</span>}
</Tag>
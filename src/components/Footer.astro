---
import Logo from "./Logo.astro";
import { footer } from '../data/site'
---

<footer class="w-full bg-panel-dark text-white py-4xl">
  <div class="container">

    <div class="flex flex-col md:flex-row gap-lg">
      <div class="flex-1">
        <Logo lightText />
      </div>

      {footer.urls.map(list => (
          <div class="flex-1 flex flex-col gap-md pl-md md:pl-0">
            <h4>{list.title}</h4>
            <ul>
              {list.items.map(item => (
                <li>
                  <a class="inline-flex py-xs text-foreground-light" href={item.href}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
    </div>

    <div class={`
      flex flex-col-reverse md:flex-row gap-md
      items-center md:items-start justify-between
      mt-3xl pt-3xl
      color-foreground-light
      border-t border-foreground-light
    `}>
      <span class="text-foreground-light text-sm opacity-70">{footer.copyText}</span>

      <div class="flex flex-row gap-md">
        <span class="text-foreground-light">{footer.kvkText}</span>
        <span class="text-foreground-light">{footer.agbText}</span>
      </div>
    </div>
  </div>
</footer>
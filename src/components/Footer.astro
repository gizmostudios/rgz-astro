---
import Logo from "./Logo.astro";


const copyText = `©${new Date().getFullYear()} RGZ Utrecht. Alle rechten voorbehouden.`;
const kvkText = 'KVK: 12345678';
const agbText = 'AGB: 95167815';

const footerUrls = [
  {
    title: 'Onze zorg',
    items: [
      {
        title: 'Verloskunde',
        href: '#'
      },
      {
        title: 'Zwangerschap',
        href: '#'
      },
      {
        title: 'Bevalling',
        href: '#'
      },
      {
        title: 'Nazorg',
        href: '#'
      },
    ]
  },
  {
    title: 'Informatie',
    items: [
      {
        title: 'Tarieven',
        href: '#'
      },
      {
        title: 'AGB-codes',
        href: '#'
      },
      {
        title: 'Voor cliënten',
        href: '#'
      },
      {
        title: 'Ons team',
        href: '#'
      },
    ]
  },
  {
    title: 'Juridisch',
    items: [
      {
        title: 'Privacyverklaring',
        href: '#',
      },
      {
        title: 'Toegankelijkheidsverklaring',
        href: '#',
      },
      {
        title: 'Contact',
        href: '#',
      },
    ]
  }
]
---

<footer class="w-full bg-panel-dark text-white py-4xl">
  <div class="container">

    <div class="flex flex-row">
      <div class="flex-1">
        <Logo lightText />
      </div>
      {footerUrls.map(list => (
          <div class="flex-1 flex flex-col gap-md">
            <h4>{list.title}</h4>
            <ul>
              {list.items.map(item => (
                <li>
                  <a class="inline-flex py-xs text-foreground-light" href={item.href}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
    </div>

    <div class={`
      flex flex-col
      md:flex-row justify-between
      color-foreground-light
      mt-3xl
      pt-3xl
      border-t border-foreground-light
    `}>
      <span class="text-foreground-light">{copyText}</span>

      <div class="flex flex-col md:flex-row gap-md">
        <span class="text-foreground-light">{kvkText}</span>
        <span class="text-foreground-light">{agbText}</span>
      </div>
    </div>
  </div>
</footer>
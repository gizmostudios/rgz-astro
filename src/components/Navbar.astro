---
import Button from "./Button.astro";
import Logo from "./Logo.astro";

const navData = [
  {
    title: 'Verloskunde',
    href: '#verloskunde'
  },
  {
    title: 'Zwangerschap',
    href: '#zwangerschap'
  },
  {
    title: 'Bevalling',
    href: '#'
  },
  {
    title: 'Nazorg',
    href: '#'
  },
  {
    title: 'Prijzen',
    href: '#'
  },
  {
    title: 'Team',
    href: '#'
  }
]

---

<nav class="fixed w-screen py-md bg-milk backdrop-blur-sm shadow-2xl z-999 border-b border-milk">
  <div class="container flex items-center justify-between">
    <div class="flex items-center gap-xl xl:gap-2xl">
      <a href="/"><Logo /></a>
  
      <ul class="gap-md hidden lg:flex">
        {navData.map(item => (
          <li>
            <a
              class={`
                nav-item py-sm
                border-b-2 border-transparent hover:border-primary
                hover:text-primary-600
              `}
              href={item.href}>{item.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-xl">
      <div class="hidden sm:flex items-center gap-sm xl:gap-md">
        <Button variant="secondary">
          <div class="flex flex-col w-6 aspect-square rounded-full overflow-hidden border-2 border-white">
            <div class="flex-1 bg-red-700"></div>
            <div class="flex-1 bg-white"></div>
            <div class="flex-1 bg-blue-800"></div>
          </div>
        </Button>
        <Button variant="secondary">Contact</Button>
        <Button>Aanmelden</Button>
      </div>

      <div class="flex flex-col w-6 h-6 gap-sm lg:hidden">
        <div class="flex-none h-0.5 bg-foreground"></div>
        <div class="flex-none h-0.5 bg-foreground"></div>
        <div class="flex-none h-0.5 bg-foreground"></div>
      </div>
    </div>
  </div>

</nav>

<style>
  .nav-item {
    transition: border-color .2s; /* I don't want to transition everything just for the border */
  }
</style>
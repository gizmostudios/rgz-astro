---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
import { navData } from '../data/topnav'

import iconPhoneSm from '../assets/icon-phone-sm.svg'
import { Image } from "astro:assets";
---

<nav id="navbar" class="fixed w-screen py-md bg-milk backdrop-blur-sm shadow-2xl z-999 border-b border-milk">
  <div class="container flex items-center justify-between">
    <div class="flex items-center gap-xl xl:gap-2xl">
      <a href="/" id="logo"><Logo /></a>
  
      <ul class="gap-md hidden lg:flex">
        {navData.map(item => (
          <li>
            <a
              class={`
                nav-item py-sm
                border-b-2 border-transparent hover:border-primary
                hover:text-primary-600
                text-sm xl:text-md
              `}
              href={item.href}>{item.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-lg">
      <div class="flex items-center gap-sm xl:gap-md">
        <div class="hidden sm:inline-flex">
          <Button variant="secondary">
            <div class="flex flex-col w-6 aspect-square rounded-full overflow-hidden border-2 border-white">
              <div class="flex-1 bg-red-700"></div>
              <div class="flex-1 bg-white"></div>
              <div class="flex-1 bg-blue-800"></div>
            </div>
          </Button>
        </div>
        <Button variant="secondary">
          <span class="hidden sm:inline">Contact</span>
          <Image class="sm:hidden" src={iconPhoneSm} alt="Contact" />
        </Button>
        <Button>
          <span class="inline">Aanmelden</span>
        </Button>
      </div>

      <div class="flex flex-col w-6 h-6 gap-sm lg:hidden">
        <div class="flex-none h-0.5 bg-foreground"></div>
        <div class="flex-none h-0.5 bg-foreground"></div>
        <div class="flex-none h-0.5 bg-foreground"></div>
      </div>
    </div>
  </div>

</nav>

<style>
  .nav-item {
    transition: border-color .2s; /* I don't want to transition everything just for the border */
  }
</style>

<script>
	const scrollToggleTarget     = document.getElementById('navbar');
  const scrollToggleClassName  = 'minimize'
  const resizeToggleClassName  = 'resizing'
  const scrollThreshold        = 100 //ms
  const resizeThrottleDuration = 100 //ms
  const scrollThrottleDuration = 20 //ms

	let reduceLogo = false;
	let resizeStarted = false;
	let scrollThrottle: ReturnType<typeof setTimeout> | null = null;
	let resizeThrottle: ReturnType<typeof setTimeout> | null = null;

	function toggleHeader() {
		if(window.scrollY > scrollThreshold && !reduceLogo) {
			reduceLogo = true;
			scrollToggleTarget?.classList.add(scrollToggleClassName);
			return;
		}

		if(window.scrollY < scrollThreshold && reduceLogo){
			reduceLogo = false;
			scrollToggleTarget?.classList.remove(scrollToggleClassName);
			return;
		}
	}

	function invokeScroll() { 
		if(scrollThrottle) clearTimeout(scrollThrottle);
		scrollThrottle = setTimeout(toggleHeader, scrollThrottleDuration);
	}

	function invokeResize() { 
		if(resizeThrottle) clearTimeout(resizeThrottle);
		if(!resizeStarted) {
			resizeStarted = true;
			onResizeStart();
		}
		
		resizeThrottle = setTimeout(onResizeEnd, resizeThrottleDuration);
	}

	function onResizeStart() {
		document.body.classList.add(resizeToggleClassName)
	}

	function onResizeEnd() {
		resizeStarted = false;
		if(resizeThrottle) clearTimeout(resizeThrottle);
		document.body.classList.remove(resizeToggleClassName)
	}

	// Only bind events if logo isn't initially minimized
	if(!scrollToggleTarget?.classList.contains(scrollToggleClassName)) {
		window.addEventListener('scroll', invokeScroll);
		toggleHeader();
	}

	window.addEventListener('resize', invokeResize);
</script>
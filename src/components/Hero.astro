---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import headerImage from "../assets/img-family.jpg"

const headerImageAlt = "Family with parents and baby feeding bottle";
const mainTitle = "Professionele geboortezorg voor iedereen";
const mainDescription = "Uw behoefte, onze missie. We staan klaar om u en uw partner door deze spannende tijd te begeleiden.";

const buttonData = [
  {
    title: 'Aanmelden',
    variant: 'primary',
    href: '#aanmelden'
  },
  {
    title: 'Stel een vraag',
    variant: 'secondary',
    href: '#vraag'
  },
]
---

<main class="flex flex-col md:flex-row justify-center relative bg-foreground">
  <Image
    src={headerImage}
    alt={headerImageAlt}
    class="aspect-portrait md:aspect-auto w-full md:max-h-200 object-cover object-center"
  />
  <div class="md:hidden w-full h-20 -mt-20 bg-linear-to-t from-foreground to-transparent"></div>

  <div class="md:absolute flex flex-col justify-center w-full h-full">
    <div class="container">
      <article
        class={`
          flex flex-col gap-md
          md:max-w-100
          -mt-70 mb-xl sm:-mt-110 sm:mb-0 md:mt-0
          bg-milk
          backdrop-blur-sm
          p-xl
          rounded-3xl rounded-bl-none
        `}
      >
        <h1>
          {mainTitle}
        </h1>
        <p class="xl:max-w-80">{mainDescription}</p>
        
        <div class="flex flex-col gap-md sm:max-w-60">
          {buttonData.map(button => (
            <Button {...button}>{button.title}</Button>
          ))}
        </div>
      </article>
    </div>
  </div>
</main>
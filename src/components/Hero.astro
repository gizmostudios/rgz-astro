---
import Button from "./Button.astro"
import pixelGrid from "../assets/ui-pixel-grid.png";
import { hero } from "../data/site"
---

<main class="flex flex-col md:flex-row justify-center relative bg-foreground">
  <video
    class={`
      w-full
      h-full
      min-h-200
      max-h-[80dvh] md:max-h-[90dvh]
      aspect-portrait md:aspect-landscape
      object-cover
    `}
    src={hero.video}
    autoplay
    loop
    muted
  />
  <div
    class="w-full h-full absolute opacity-50 invert"
    style={`background-image: url(${pixelGrid.src})`}
  ></div>
  <div class="md:hidden w-full h-20 -mt-20 bg-linear-to-t from-foreground to-transparent"></div>

  <div class="md:absolute flex flex-col justify-center w-full h-full">
    <div class="container">
      <article
        class={`
          flex flex-col gap-md
          md:max-w-100
          -mt-70 mb-xl sm:-mt-110 sm:mb-0 md:mt-20
          bg-milk
          backdrop-blur-sm
          p-xl
          rounded-3xl rounded-bl-none
        `}
      >
        <h1 class="text-xl lg:text-2xl text-primary-700">
          {hero.title}
        </h1>
        <p class="xl:max-w-80">{hero.description}</p>
        
        <div class="flex flex-col gap-md">
          {hero.buttons.map(button => (
            <Button {...button}>{button.title}</Button>
          ))}
        </div>
      </article>
    </div>
  </div>
</main>